{
  "ref": "yt:tw001xxxxxx",
  "source": {
    "lang": "zh-Hant-TW",
    "cues": [
      { "start": "00:00:01.000", "end": "00:00:05.000", "text": "大家好，歡迎來到今天的節目。" },
      { "start": "00:00:06.000", "end": "00:00:10.000", "text": "今天我們要介紹台北的幾個特色夜市。" },
      { "start": "00:00:11.000", "end": "00:00:15.000", "text": "第一站是士林夜市，這裡的小吃種類非常多。" },
      { "start": "00:00:16.000", "end": "00:00:20.000", "text": "大家一定要試試看他們的大餅包小餅。" },
      { "start": "00:00:21.000", "end": "00:00:25.000", "text": "接著我們搭捷運前往饒河街。" },
      { "start": "00:00:26.000", "end": "00:00:30.000", "text": "那裡的胡椒餅每天都有人排隊。" },
      { "start": "00:00:31.000", "end": "00:00:35.000", "text": "吃完之後可以沿著河邊散步消化一下。" },
      { "start": "00:00:36.000", "end": "00:00:40.000", "text": "最後一站是寧夏夜市，價格比較親民。" },
      { "start": "00:00:41.000", "end": "00:00:45.000", "text": "滷肉飯和芋圓都是在地人推薦的美食。" },
      { "start": "00:00:46.000", "end": "00:00:50.000", "text": "今天的分享就到這裡，我們下次再見。" }
    ]
  }
}
