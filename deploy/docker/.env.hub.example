# Hub（compose.hub.yaml）的密鑰。複製成 .env.hub 後填入；.env.hub 含有密鑰，不要提交到版本控制。
# 每一個都用隨機值，例如：
#   openssl rand -base64 32   # 主金鑰、session 金鑰
#   openssl rand -hex 24      # 資料庫密碼、S3 secret（只用十六進位，放進 DSN 不必跳脫）

# 信封加密的主金鑰（下架申請的聯絡 email 以它加密），至少 32 個字元。不在資料庫備份內，請另外保存；遺失後無法解密。
NOTESTEME_HUB_MASTER_KEY=
# session 金鑰（加密等待中登入的 PKCE verifier），至少 32 個字元。更換後進行中的登入會失敗，已登入的 session 不受影響。
NOTESTEME_HUB_SESSION_KEY=

# Postgres 的密碼（compose 會組成 NOTESTEME_HUB_STORE_DSN）。只用英數字，避免 DSN 需要 URL 跳脫。
NOTESTEME_HUB_POSTGRES_PASSWORD=

# hub-s3（SeaweedFS）的帳號，同時是 Hub 的 S3 憑證。只能用英數字（compose 直接把它們寫進 identity 檔，不做跳脫）。
NOTESTEME_HUB_S3_ACCESS_KEY_ID=notestemehub
NOTESTEME_HUB_S3_SECRET_ACCESS_KEY=
# NOTESTEME_HUB_S3_BUCKET=notesteme-hub

# 有在設定檔寫 oauth.<provider>.client_id 的登入方式，要填對應的 client secret。
NOTESTEME_HUB_OAUTH_GITHUB_CLIENT_SECRET=
NOTESTEME_HUB_OAUTH_GOOGLE_CLIENT_SECRET=
NOTESTEME_HUB_OAUTH_LINUXDO_CLIENT_SECRET=

# 選填：主機上映射的 port（只綁 127.0.0.1）與 image。
# NOTESTEME_HUB_PORT=8090
# 使用發布的 image 時指定版本，並以 up -d --no-build 啟動（docs/hub-deployment.md）：
# NOTESTEME_HUB_IMAGE=ghcr.io/cxyfer/notesteme-hub:0.1.0
