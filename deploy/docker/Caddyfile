# vps profile 的反向代理（OPS-R19）。網域來自 .env 的 NOTESTEME_DOMAIN，Caddy 自動取得與更新 HTTPS 憑證。
{$NOTESTEME_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# compose 以 NOTESTEME_TRUSTED_PROXIES 把 caddy 的固定位址設成 trusted_proxies（AUTH-R6）；
	# notesteme 才會改用 X-Forwarded-For 區分登入的來源。
	reverse_proxy notesteme:8080
}
