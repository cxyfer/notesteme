# 複製成 .env 後填入。.env 含有密鑰，不要提交到版本控制。

# 加密 DB 中資料金鑰用的 master key。建議產生 32 bytes 的 base64：
#   openssl rand -base64 32
# master key 不在備份內，請另外保存；遺失後 API key 與 cookie 需要重新輸入。
NOTESTEME_MASTER_KEY=

# Web UI 的登入密碼，只在第一次啟動時寫入 DB。
NOTESTEME_PASSWORD=

# 選填：主機上映射的 port 與使用的 image。
# NOTESTEME_PORT=8080
# NOTESTEME_IMAGE=ghcr.io/cxyfer/notesteme:latest
