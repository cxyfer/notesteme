{
  "name": "@notesteme/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && cd .. && eslint -c client/eslint.config.js shared",
    "format": "prettier --write . ../shared",
    "format:check": "prettier --check . ../shared",
    "test": "vitest run && npm run check:i18n",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "gen:notices": "node scripts/gen-notices.mjs",
    "gen:api": "openapi-typescript ../../internal/api/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@fontsource/noto-serif-tc": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-toast": "1.3.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "i18next": "26.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@lezer/common": "1.5.5",
    "style-mod": "4.1.4"
  }
}
