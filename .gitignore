# Web UI（web/client）：npm 套件與建置產物；dist/.gitkeep 要保留，go:embed 才編譯得過。
/web/client/node_modules/
/web/client/dist/*
!/web/client/dist/.gitkeep
/web/client/coverage/
# 瀏覽器 e2e（Playwright）的產物：binary、session、測試結果、報告、截圖集
/web/client/e2e/.out/
# Hub UI（web/hub，M5-S9）：同上
/web/hub/node_modules/
/web/hub/dist/*
!/web/hub/dist/.gitkeep
/web/hub/coverage/
*.tsbuildinfo
# 本機的暫存檔（scripts/release-notes.sh 的草稿）
/.tmp/
