{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "code": {
            "description": "機器可讀的錯誤代碼",
            "type": "string"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "failed": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "file_line": {
            "format": "int64",
            "type": "integer"
          },
          "item_id": {
            "type": "string"
          },
          "line": {
            "format": "int64",
            "type": "integer"
          },
          "message": {
            "description": "給人看的說明",
            "type": "string"
          },
          "purged": {
            "format": "int64",
            "type": "integer"
          },
          "required_permission": {
            "type": "string"
          },
          "required_scope": {
            "type": "string"
          },
          "retry_after_s": {
            "format": "int64",
            "type": "integer"
          },
          "undefined_variables": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "used_by": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "type": "object"
      },
      "StatusOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
